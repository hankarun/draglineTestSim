			</attribute-nvp>

			<!-- ============================================================
			     Dragline deformable-terrain integration (mtDragline pipeline)
			     ============================================================
			     These attributes are RUNTIME-TUNABLE (placed under
			     <local><initial-state-repository> with dynamicAttribute="true")
			     so the instructor can adjust them via UI / SDL during a
			     scenario. The DeformableTerrainParams.* values are snapshotted
			     into ContactHistoryRecord on FIRST contact between the
			     DraglineBlade actor and the terrain, so mid-contact tuning
			     only takes effect for the NEXT bucket-down event.

			     The TraceDataLoggerEnabled boolean, in contrast, is re-read
			     every tick by LiebherrHS825Actuator (BulldozerActuator pattern)
			     — toggling it from instructor UI opens or closes the CSV
			     immediately and is the recommended path during tuning. -->
			<attribute-nvp name="DeformableTerrainParams.draglineBucketWidth" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="2.5"/>
			</attribute-nvp>
			<attribute-nvp name="DeformableTerrainParams.dragResistanceCoeff" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="800.0"/>
			</attribute-nvp>
			<attribute-nvp name="DeformableTerrainParams.bucketWeight" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="2000.0"/>
			</attribute-nvp>
			<attribute-nvp name="DeformableTerrainParams.idealPenetrationAngle" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="30.0"/>
			</attribute-nvp>
			<attribute-nvp name="DeformableTerrainParams.penetrationLimitForce" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="40000.0"/>
			</attribute-nvp>
			<!-- Edge-triggered: rising-edge opens a new CSV
			     hs825_dragline_log_<entityID>_YYYYMMDD_HHMMSS.csv. Pair with
			     DeformableTerrain.TraceDataLoggerEnabled on the terrain entity
			     and join the two files on wallTimeMs to validate the 1-tick
			     resistance-feedback latency. -->
			<attribute-nvp name="LiebherrHS825Actuator.TraceDataLoggerEnabled" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>

			<!-- ============================================================
			     Litronic Servis Paneli (SUYM GenericDashboardGenerator)
			     dashboard state — LiebherrHS825DashboardController tarafindan
			     yonetilir. Bu attribute'lar olmadan controller init'te
			     getAttributePtr_nonConst null doner ve panel dormant kalir.
			     ============================================================ -->
			<!-- Ekran durum vektoru (one-hot). Index = LIEBHERRHS825DraglineScreenNavigation<N>
			     state sirasi: [0]Ana [1]Servis [2]Bom [3]Liste [4]Keypad.
			     Dashboard XML touchArea transition'lari da bu vektoru one-hot gunceller;
			     controller init garantisi + gercek-durum kopru gorevi gorur. -->
			<attribute-nvp name="LiebherrHS825.DisplayScreenStates" dynamicAttribute="true">
				<attribute xsi:type="attr:VectorAttribute">
					<attr:item xsi:type="attr:BoolAttribute" value="true"/>   <!-- [0] Ana    -->
					<attr:item xsi:type="attr:BoolAttribute" value="false"/>  <!-- [1] Servis -->
					<attr:item xsi:type="attr:BoolAttribute" value="false"/>  <!-- [2] Bom    -->
					<attr:item xsi:type="attr:BoolAttribute" value="false"/>  <!-- [3] Liste  -->
					<attr:item xsi:type="attr:BoolAttribute" value="false"/>  <!-- [4] Keypad -->
				</attribute>
			</attribute-nvp>
			<!-- Opsiyonel menu navigasyon girdisi: 0..4 yazilinca controller ilgili
			     ekrana gecer ve -1'e sifirlar (tek-atislik). -->
			<attribute-nvp name="LiebherrHS825.MenuInputIndex" dynamicAttribute="true">
				<attribute xsi:type="attr:IntAttribute" value="-1"/>
			</attribute-nvp>
			<!-- Sag konsol LED bayraklari — controller her tick GERCEK sim durumundan
			     besler: FreewheelLit = Dragline.SlewFreewheelActive,
			     SlewGearLit = (Dragline.SlewSpeedGear >= 3). -->
			<attribute-nvp name="LiebherrHS825.SagKonsol.FreewheelLit" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.SagKonsol.SlewGearLit" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<!-- Kasnak_State isigi: ArmBlink = tus basili ve iki kasnak da secili DEGIL iken 0.5s yanip soner; KasnakSolid = ikisi de secili. -->
			<attribute-nvp name="LiebherrHS825.SagKonsol.KasnakArmBlink" dynamicAttribute="true">
			    <attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.SagKonsol.KasnakSolid" dynamicAttribute="true">
			    <attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.Hoist.HookArmBlink" dynamicAttribute="true">
			    <attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.Drag.HookArmBlink" dynamicAttribute="true">
			    <attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<!-- Ana dashboard Kasnak 1/2 kanca simgesi: o kasnak serbest dusme icin secili VE
			     o kasnagin dilim freni pedali TAM basili iken gorunur (ayak kalkinca kalkar).
			     LiebherrHS825DashboardController::updateHookVisibility yazar. -->
			<attribute-nvp name="LiebherrHS825.Hoist.HookVisible" dynamicAttribute="true">
			    <attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.Drag.HookVisible" dynamicAttribute="true">
			    <attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<!-- ════ Litronic uyari lambasi bayraklari (controller yazar) ════
			     Mevcut Bulldozer.*Malfunction bayraklarindan + esiklerden beslenir.
			     Dashboard XML bu bool'lari enableDisableAttrName ile koşullu uyari
			     overlay'lerini gostermek icin okur. -->
			<attribute-nvp name="LiebherrHS825.HydOilTempWarn" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.EngineTempWarn" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.EngineOilPressureWarn" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.BatteryWarn" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.LowFuelWarn" dynamicAttribute="true">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<!-- Ana ekran ortasinda gosterilecek canli RPM okuma metni (test
			     metni "asdasdasdasd" yerine). Controller her tick gercek RPM yazar. -->
			<attribute-nvp name="LiebherrHS825.RpmText" dynamicAttribute="true">
				<attribute xsi:type="attr:StringAttribute" value="0"/>
			</attribute-nvp>
			<!-- ════ Servis ekrani 6-gosterge bar degerleri ════
			     rpm/coolant/hyd-temp dogrudan HeavyEngine/Bulldozer SR'dan okunur;
			     basinc gostergelerinin (P pilot + motor yagi) dogrudan sim kaynagi
			     olmadigindan controller bunlari motor devrinden turetir, yakit %'sini
			     de FuelLevel/FuelTankCapacity'den hesaplar. Hepsi her tick yazilir. -->
			<attribute-nvp name="LiebherrHS825.PilotPressureBar" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.EngineOilPressureBar" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<attribute-nvp name="LiebherrHS825.FuelPercent" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<!-- ════════════════════════════════════════════════════════════
			     BOOM ACI OLCERI (ayri pencere widget, 2026-08-11)
			       Dragline.BoomAngleDeg     : DraglineActuator her tick yazar =
			         BoomAngleBaseDeg + luffing pitch, [0,90] clamp. Ayri pencere
			         gostergesi (LIEBHERRHS825Dragline_BoomAngle.xml) <ibre> bu attr'a
			         baglanir -> "var olan aciyi goster".
			       Dragline.BoomAngleBaseDeg : gostergeyi gercek boom yuksekligine
			         kalibre eden taban ofset (default 45). dynamicAttribute -> egitmen
			         UI'dan canli ayarlanir (rebuild gerekmez).
			     ★ 2026-08-11 (K8): 45.0 -> 38.57. Yeni govde_kol.fbx mesh'inde bomun
			       GOMULU dinlenme acisi (pitch 0 pozu) 43.67 dereceden 38.57 dereceye
			       dustu (pivot->makara 19.267 m @43.67 => 26.023 m @38.57; olcum
			       DraglineKinematics.h basligindaki ada ayristirmasi). BoomAngleBaseDeg
			       tam olarak bu gomulu acidir (mutlak aci = base + luffing pitch), yani
			       45'te birakilsa gosterge 6.43 derece YANLIS okur. -->
			<attribute-nvp name="Dragline.BoomAngleDeg" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="38.57"/>
			</attribute-nvp>
			<attribute-nvp name="Dragline.BoomAngleBaseDeg" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="38.57"/>
			</attribute-nvp>
			<!-- ════════════════════════════════════════════════════════════
			     BOOM ACI BANDI (K7, 2026-08-11) ve BASLANGIC HOIST BOYU (K12).
			     Ikisi de base ~GenericDragline.entity'de generic default tasiyor;
			     burada MAKINEYE OZGU olarak eziliyor (yeni bom geometrisi HS825'e ait).

			     K7 : BoomMin/MaxDeg GORELIDIR (0 = mesh'in gomulu dinlenme pozu).
			          Gomulu aci 43.67 -> 38.57 dereceye dustugu icin base'in -45/+45
			          degerleri mutlak bandi kendiliginden kaydirdi:
			            eski mesh : mutlak  -1.33 ... 88.67 derece
			            yeni mesh : mutlak  -6.43 ... 83.57 derece  (bom yerin ALTINA iner)
			          Gercek banda cekildi (Liebherr HS 8x5 HD datasheet 15 ... 82 derece,
			          base'deki BoomRateDegPerSec notunun kaynagi ayni datasheet):
			            BoomMinDeg = 15 - 38.57 = -23.57  (mutlak 15 derece)
			            BoomMaxDeg = 82 - 38.57 = +43.43  (mutlak 82 derece)
			     ★ K7b (2026-08-13, in-sim: "aci en fazla 63 civari cikiyor"):
			          K7'nin yukaridaki iki satiri "mutlak = base + pitch" varsayimiyla
			          turetilmisti. Ayni gun yapilan ISARET duzeltmesi (DraglineActuator.cpp
			          ~2128, kullanici geri bildirimi) mutlak aciyi "base - pitch" yapti:
			          bomu KALDIRINCA boomPitchDeg AZALIR. Limit bandi aynalanmadigi icin
			          erisilebilir mutlak bant TERSINE dondu:
			            kaldirma tavani = 38.57 - (-23.57) = 62.14  (gorulen ~63)
			            indirme tabani  = 38.57 -   43.43  = -4.86  (gosterge 0'a kirpiliyor)
			          Trace kaniti (dragline_actuator_log_20260813_154037.csv): kol geri
			          (boomCmdEff<0) iken pitch AZALIYOR ve boomMinDeg=-23.57'de doyuyor;
			          912 satirin tamaminda pitch bandi [-23.570, -19.094].
			          Duzeltme = iki degeri NEGATIFLE + YER DEGISTIR (pitch = base - mutlak):
			            mutlak 82 -> pitch = 38.57 - 82 = -43.43  => BoomMinDeg
			            mutlak 15 -> pitch = 38.57 - 15 = +23.57  => BoomMaxDeg
			          Hedef bant (15 ... 82 mutlak) K7 ile AYNI; yalnizca isaret cercevesi
			          duzeltildi.
			          Yan fayda: Dragline.BoomAngleDeg cikisi [0,90] clamp'li oldugu icin
			          negatif mutlak acide gosterge kirpiliyordu; artik kirpilmaz.

			     K12: HoistLenInitialM (senaryo basi / reset'te bir KEZ set edilir).
			          Makara +2.92 m yukari, +6.41 m ileri gitti; base'in 5.73'u yeni
			          makarayla kovayi ~8.5 m havada birakiyor (ekran goruntusu: kova
			          bomun yari yuksekliginde asili). Kova-alti hesabi:
			            makara Y (dinlenme) = pivot 1.552 + 16.223           = 17.775
			            makara altindaki rig = hoistLen + UpperChainLenM 2.6
			                                 + trunnion->bicak 1.26          = hoistLen + 3.86
			            bicak Y = 17.775 - hoistLen - 3.86
			          hoistLen 13.0 => bicak ~0.92 m (arac origin duzlemi ustunde) = yere
			          yakin. [HoistLenMinM 3.5, HoistLenMaxM] icinde. Arazi yuksekligi
			          spawn noktasinda farkli olabilir; nihai trim IN-SIM karari
			          (dynamicAttribute, canli denenebilir).
			          ★ K12b (in-sim 2. tur, kullanici "baslangic degeri fazla, kisaltalim"):
			            13.0 -> 8.0. Ayni zincirle bicak = 17.775 - 8.0 - 3.86 = ~5.92 m,
			            yani BOM DEGISMEDEN ONCEKI gorunumun aynisi (eski makara 14.855 +
			            eski HoistLenInitialM 5.73 => bicak ~5.27 m). Kova havada, yoke
			            boom-ucune yakin. -->
			<attribute-nvp name="Dragline.BoomMinDeg" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="-43.43"/>
			</attribute-nvp>
			<attribute-nvp name="Dragline.BoomMaxDeg" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="23.57"/>
			</attribute-nvp>
			<attribute-nvp name="Dragline.HoistLenInitialM" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="8.0"/>
			</attribute-nvp>
			<!-- ════════════════════════════════════════════════════════════
			     DRAG HALATI MAX BOYU (K14, 2026-08-11 in-sim 1. tur, kullanici istegi:
			     "drag halati max boyutu da artmali"). Base ~GenericDragline.entity 35.0
			     tasiyor; o deger 19.27 m'lik ESKI boma gore ayarlanmisti (2026-07-08).
			     Yeni bom pivot->makara 26.023 m = x1.351 ⇒ ayni oranla olceklendi:
			       35.0 x 1.351 = 47.3  ->  48.0 (yuvarlak, egitmen knob'u)
			     Gercek makine sinirinin icinde: HS 825 HD ana vinci 1. kat 40-52 m
			     (teslim 60 m), yani 48 fiziksel olarak tutarli.
			     Fonksiyonu: tam pay-out'ta kova hoist'tan SERBEST asili kalabilsin ki
			     agiz-asagi (dokme) acisi kirilmasin. Yeni makara +6.41 m ileri / +2.92 m
			     yukari gittigi icin fairlead->kova mesafesi her rejimde buyudu.
			     ⚠ Bunun yaninda Dragline.HoistLenMaxM (base 42) bazi konfigurasyonlarda
			        ARTIK ONCE baglar: bom mutlak 82 derecede makara (5.01, 27.32); kova
			        48 m drag ile ~49 m disarida olsa hoist gereksinimi
			        sqrt((49-5.01)^2 + 27.32^2) = 51.8 m > 42 ⇒ hoist tavani kesiyor.
			        Bu MESRU bir limit (iki tavan birlikte calisiyor) ama tam cast
			        istenirse HoistLenMaxM de buyutulmeli. Ikisi de dynamicAttribute.
			        (K15 ile buyutuldu, asagi bkz.) -->
			<attribute-nvp name="Dragline.DragRopeLenMaxM" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="48.0"/>
			</attribute-nvp>
			<!-- ════════════════════════════════════════════════════════════
			     HOIST HALATI MAX BOYU (K15, 2026-08-11, kullanici istegi). Base 42.0
			     ESKI 19.27 m'lik boma gore ayarlanmisti; yeni makara +2.92 m yukari,
			     +6.41 m ileri gitti VE drag tavani 48'e cikti (K14) ⇒ 42 artik drag'den
			     ONCE bagliyordu (tam cast yapilamiyordu).
			     GEOMETRIK EN KOTU HAL (bu deger buradan turetildi, olcek tahmininden degil):
			       jant anchor'i pivottan 26.402 m @ 37.92 derece
			         (|16.223, 20.831|; aks referansi 26.023 @ 38.57 = BoomAngleBaseDeg)
			       kova TAM cast: drag 48 m, fairlead (0.118, 1.852, 1.386), socket ~0.7 m
			         yerden ⇒ slew ekseninden yatay D = 1.386 + sqrt(48^2 - 1.2^2) = 49.37 m
			       equalizer (hoist'in gerçek ucu) bicaktan
			         UpperChainLenM 2.6 + trunnion->bicak 1.26 = 3.86 m yukarida
			       bom MAX'ta (mutlak 82 derece) makara = (1.552+26.147, 1.386+3.674)
			                                           = (27.699 yukari, 5.060 ileri)
			         gereken hoist = sqrt((49.37-5.06)^2 + (27.699-3.86)^2) = 50.32 m  <== BAGLAYAN
			       bom MIN'de (mutlak 15 derece) gereken hoist = 22.9 m (bol bol yetiyor)
			     ⇒ 50.32 m tavanin ALTINDA kalmali. Secilen 55.0:
			       * en kotu hali ~%9 payla karsilar (arazi yuksekligi/egim payi)
			       * gercek makine sinirinin icinde: HS 825 HD ana vinc halat TESLIM boyu 60 m
			         (1. kat 40-52 m; 55 = 2. kata tasan ama halat uzunlugu icinde)
			       * bom-faktoru olcegi 42 x 1.351 = 56.7 ile de tutarli (yakin)
			     HoistLenMinM (3.5) DEGISMEDI — sway singularitesi tabani, bkz base notu.
			     Uzun sarkac = daha yavas sway; solver icin risk yok (risk MIN tarafinda). -->
			<attribute-nvp name="Dragline.HoistLenMaxM" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="55.0"/>
			</attribute-nvp>
			<!-- ════════════════════════════════════════════════════════════
			     DRAG FAIRLEAD NOKTASI (K4b, 2026-08-12) — kullanici: "drag halatinin
			     kule ile bagli oldugu yer yanlis; kol_alt_makara'nin UC TARAFINDAKI
			     SILINDIRLERIN ORTASINA baglanmali" (bom-ucu yakin plani, kirmizi isaret).
			     ════════════════════════════════════════════════════════════
			     Base ~GenericDragline.entity K4 (08-12) X'i dogru hesaplamis (-0.150) ama
			     Y/Z boom AYAGINDA kalmis (-0.165 / 0.164) => halat pivotun icinden cikiyor
			     gorunuyordu, uctaki catal makarasindan degil (~3.1 m geride).

			     OLCUM (ada ayristirmasi, kol_alt_makara.fbx, govde-yerel = (x, y, -z)):
			       uctaki IKI DIKEY SILINDIR: sol (-0.103, 0.571, 3.173) / sag (+0.099, 0.571, 3.173)
			         zarf Y[0.070, 1.073] (yuk 1.003 m)  Z[3.050, 3.297]
			         => ORTA (kirmizi nokta, orta yukseklik) = (-0.002, 0.571, 3.173)
			       ⚠ O parcada GERCEK bir makara TEKERI YOK: daire fiti "R=0.499" veriyordu
			         ama o, uclari yuvarlatilmis DIKEY CUBUKLARIN iki yuvarlak ucuna oturan
			         artefakt (Z ekseni yalniz 0.247 m). Yani "silindirler" tam olarak bunlar.
			     ★★ 2026-08-12 IN-SIM DUZELTMESI (kullanici: "karsidan bakildiginda baglanti
			        yeri biraz kayik, kirmizi yere tasinmali"): ONCE parca root ofseti
			        (-0.1496, -0.0017, +0.0010) EKLENMISTI -> X -0.150. **O OFSET YOK.**
			        KANIT: SR-poz ile surulen parcalarda prefab'in root transform.position'i
			        YOKSAYILIR, poz onu ezer:
			          kepce.simig      root pos = (4087002.47, 4089093.38, 2654130.44)  <- DUNYA koordinati
			          palet/govde.simig root pos = (4132686, 4089115, 2582378) benzeri
			          govde_kol.simig  root pos = (0.1178, 1.5517, 1.3859) = tam boom pivotu
			            -> eklenirse bom 1.55 m yukari + 1.39 m ileri kayardi; DOGRU render ediyor.
			        Bu root pozlari yalniz authoring artefakti (son kaydedilen sahne konumu).
			        ⇒ kol_alt_makara (BdSR[2]->Bd.Pose'a bagli) MESH-YEREL cercevesi = BOOM
			          GOVDE cercevesidir. Olculen silindir-ortasi DOGRUDAN bom-yereldir.
			       => HEDEF bom-yerel = (-0.002, 0.571, 3.173)   [X ~ 0 = silindirlerin orta cizgisi]
			          (eski hatali deger X -0.150 => halat orta cizginin 0.15 m solunda kaliyordu)

			     ★ SONUC: fairlead artik LUFFING ILE HAREKET EDEN bir ankraj. kol_alt_makara
			       entity'de BdSR[2]->Bd.Pose'a (boom pozu) bagli oldugu icin bomla doner.
			       Pivottan yaricap 0.233 -> 3.225 m (x13.9):
			         bom MIN (mutlak 15)  fairlead (Z +3.137, Y -0.747)
			         dinlenme (38.57)     fairlead (Z +3.174, Y +0.569)
			         bom MAX (mutlak 82)  fairlead (Z +1.914, Y +2.595)
			       => dusey gezi 0.241 -> 3.343 m, ark 0.272 -> 3.771 m. Yani bom luff ederken
			       drag halatinin efektif boyu KOL GIRDISI OLMADAN ~3 m degisir.
			       Gercek dragline'da fairlead genelde DONER UST YAPIDA olur (tam bu yuzden:
			       luff'ta drag boyu degismesin). Boma bagli olmasi kullanici/asset secimi;
			       fiziksel sonucu IN-SIM izlenmeli.

			     OTOMATIK TAKIP EDENLER (ek is yok): S2 spawn tohumu |fairlead-lip|
			       19.87 -> 16.78 m · gorsel drag halati (solveChain fairlead'den baslar) ·
			       lipFairDist tabanli tavan/trim/wrap · dragDir = fairlead - dragSocket
			       (terrain DragPullForce YONU degisir, daha yatay -> digDepthF izlenmeli).
			     KONTROL EDILECEKLER: kBoomClearance(3.5) segmenti 26.376 -> 23.597 m ve yakin
			       ucu 3 m disari kayiyor -> yuksek-bom kacagi (70-82 derecede %23.4 komutsuz
			       drag uzamasi, trace 20260811_185047) DEGISIR, olcmeden varsayilamaz ·
			       DragRopeLenMinM 4.0 tam-drag-in geometrisi · X = -0.150 asimetrisi
			       (modelcide kol_alt_makara X -0.0316 vs govde_kol +0.118 = 0.15 m fark;
			        kasitli mi? degilse drag halati boom duzleminin 0.15 m solunda kaliyor).
			     ★ 2026-08-17 CEVAP: KASITLI (modelcinin gercek geometrisi). IG prefab ROOT pozunu
			       yoksaydigi ve kol_alt_makara ile govde_kol AYNI BdSR[2] poz'una bagli oldugu icin
			       o 0.15 m modelci ofseti in-sim KAYBOLUYORDU; kol_alt_makara.simig child'lari
			       (-0.149441, -0.001456, +0.001105) kaydirilarak geri getirildi. Dolayisiyla
			       fairlead = makaralarin YENI ortasi (-0.151337, 0.570037, 3.174412). Eski deger
			       (-0.002/0.571/3.173) kaydirma oncesi prefab-yerel ortaydi; kod base default'u
			       (-0.150) bu gercek geometriye bastan beri yakindi. -->
			<attribute-nvp name="Dragline.Rig.FairleadLocalXM" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="-0.151337"/>
			</attribute-nvp>
			<attribute-nvp name="Dragline.Rig.FairleadLocalYM" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="0.570037"/>
			</attribute-nvp>
			<attribute-nvp name="Dragline.Rig.FairleadLocalZM" dynamicAttribute="true">
				<attribute xsi:type="attr:FloatAttribute" value="3.174412"/>
			</attribute-nvp>
			<!-- ★ 2026-09-02 BUCKETTOP (dump block, kepce_ust_2) MESH NISANI.
			     Mesh YOKE dugumune cizilir (kullanici teyidi: "mor obje onceden dogru yerdeydi").
			     Prefab pivot'u mesh govdesinin ortasinda olmayabilir -> kayik gorunurse bu uc
