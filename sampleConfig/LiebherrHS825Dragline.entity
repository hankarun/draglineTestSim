			</connection>
			<connection>
				<from componentName="EngineController" port="mLeftThrottleOutPort"/>
				<to componentName="BulldozerJointActuator" port="mLeftThrottleInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mRightThrottleOutPort"/>
				<to componentName="BulldozerJointActuator" port="mRightThrottleInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mLeftSpeedOutPort"/>
				<to componentName="BulldozerJointActuator" port="mLeftPalletSpeedInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mRightSpeedOutPort"/>
				<to componentName="BulldozerJointActuator" port="mRightPalletSpeedInPort"/>
			</connection>
			<connection>
