				<to componentName="EngineController" port="mWiperExtraWater"/>
			</connection>
			<!-- On cam per-pencere silecek suyu: InputController.pushWiperWaterPorts ->
			     EngineController.mFrontWiperWaterInPort. Bu baglanti olmadan frontWater hep
			     false kaliyor ve Wiper.FrontWiperWaterEffect (IG su-puskurtme 10237) hic acilmiyordu. -->
			<connection>
				<from componentName="HeavyIndustryInputController" port="mFrontWiperWaterOut"/>
				<to componentName="EngineController" port="mFrontWiperWaterInPort"/>
			</connection>
			<!--Engine Controller-->
			<connection>
				<from componentName="EngineController" port="mEngineIsWorkingOutPort"/>
				<to componentName="BulldozerJointActuator" port="mEngineIsWorkingInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mEngineIsWorkingOutPort"/>
				<to componentName="ModelHeavyIndustry.KinematicTankActuator" port="mEngineIsWorkingInPort"/>
			</connection>
			<!-- Motor kapisi -> DraglineActuator. Dozer'in isControlEnabled() formulunun
			     aynisi kurulur: serbest = engineWorking && !safetyLocked. Dragline'da
			     daha once HIC motor kapisi yoktu (winç/slew motor kapaliyken de calisiyordu). -->
			<connection>
				<from componentName="EngineController" port="mEngineIsWorkingOutPort"/>
				<to componentName="DraglineActuator" port="mEngineIsWorkingInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mMaxSpeedOutPort"/>
				<to componentName="ModelHeavyIndustry.KinematicTankActuator" port="mMaxSpeedInPort"/>
			</connection>
