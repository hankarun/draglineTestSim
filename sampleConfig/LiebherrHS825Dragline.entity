			<connection>
				<from componentName="EngineController" port="mShakeContinousPitchRollOutPort"/>
				<to componentName="VisualEffectController" port="mShakeContinousPitchRollInPort"/>
			</connection>
		</connections>
	</local>
	<remote>
		<initial-state-repository classType="SimFramework.SimObj.SimObjectStateRepository"/>
