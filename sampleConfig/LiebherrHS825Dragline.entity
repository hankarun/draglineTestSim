			</attribute-nvp>
			<!-- HS825 sogutma-suyu (coolant) arizasi motor torku carpani: 1.0=etkisiz
			     (dozer/ekskavator varsayilani), 0.4 = belirgin guc kaybi. Egitmen
			     "Sogutucu Seviyesi" arizasini actiginda motor yuk altinda boger. -->
			<attribute-nvp name="EngineController.CoolantLevelMalfunctionTorqueReducement">
				<attribute xsi:type="attr:FloatAttribute" value="0.4"/>
			</attribute-nvp>
			<attribute-nvp name="Bulldozer.TransferGearboxOilTempMalfunction">
