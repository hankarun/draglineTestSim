				<to componentName="VisualEffectController" port="mIsBladeInContactInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mLeftSpeedOutPort"/>
				<to componentName="VisualEffectController" port="mLeftTrackSpeedInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mRightSpeedOutPort"/>
				<to componentName="VisualEffectController" port="mRightTrackSpeedInPort"/>
			</connection>
			<connection>
				<from componentName="VisualEffectController" port="mExtraHPREffectOutPort"/>
				<to componentName="Vehicle2DOFMotionPlatformActuator" port="mExtraHPREffectInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mForwardBackwardPitchingOutPort"/>
				<to componentName="VisualEffectController" port="mForwardBackwardPitchingInPort"/>
			</connection>
			<connection>
				<from componentName="EngineController" port="mShakingOutPort"/>
