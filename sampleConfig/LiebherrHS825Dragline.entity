			<!-- ════ HS825 arıza-listesi (metin) tetikleyici bool'lari ════
			     Egitmen konsolundan set edilir; DashboardController bunlardan
			     Liste ekrani metin kuyrugunu (FaultRowNText) uretir, sol-alt liste
			     butonunu FaultBlinkVisible ile titretir, onay (✓) hepsini temizler. -->
			<!-- M01B6 Hava filtresi kirli ÖN UYARI (ayri tetiklenir) -->
			<attribute-nvp name="Bulldozer.AirFilterPreWarningMalfunction">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
