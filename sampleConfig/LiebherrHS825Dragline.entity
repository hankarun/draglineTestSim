			<attribute-nvp name="Bulldozer.FuelPressurePreWarningMalfunction">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
			</attribute-nvp>
			<!-- Yakit basinci ARIZA (kirmizi) — M01C2 cok dusuk + M01C4 cok yuksek -->
			<attribute-nvp name="Bulldozer.FuelPressureMalfunction">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
