						</SimIG:event>
					</SimIG:entity>
					<!-- ★★ 2026-09-02 SPREADER BAR (SimIG type 13268 = kepce_ust_1).
					     Kullanici (3. foto, iki ip arasindaki kirmizi elips): "bu kirmizi yere,
					     yani iki ip arasina type-id 13268 olan obje gelmeli." 1. fotoda kaldirilan
					     duz separator cizgisinin yerine GERCEK parca.
					     Bu mesh daha once HICBIR entity'de spawn EDILMIYORDU (yalniz authoring
					     master Liebherr_HS825.simig icinde cocuk olarak duruyordu) -> burada
					     STANDALONE (instance-id="9") eklendi, yani Pose DUNYA cercevesindedir
					     (BucketTopBody gibi; instance-refid'li kardesler kova-yerel olurdu).
					     DraglineActuator her tick gercek SPREADER dugumunu yazar:
					       +X = bar ekseni (spreaderL->spreaderR), +Y = ust zincir hatti
					       (spreader->yoke), +Z = X^Y. Mesh nisani: Dragline.Rig.SpreaderBarMeshLocal{X,Y,Z}M
					     Mesh olcumu (kepce_ust_1.fbx): 1.649 m genis duz plaka, govdesi origin'in
					       1.879 m USTUNDE authored -> knob Y = -1.879 barin merkezini dugume oturtur. -->
					<SimIG:entity type-id="13268" description="SpreaderBar" instance-id="9">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="SpreaderBarPose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
					</SimIG:entity>
