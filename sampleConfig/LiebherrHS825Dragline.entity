				<to componentName="VisualEffectController" port="mPatinajStateInPort"/>
			</connection>
			<!-- Debugging
			<connection>
				<from componentName="HeavyIndustryInputController" port="mTargetEngineRPMOutPort" />
				<to componentName="VisualEffectController" port="mPatinajStateInPort" />
			</connection>
			-->
			<connection>
				<from componentName="BulldozerJointActuator" port="mIsRiperInContactOutPort"/>
				<to componentName="VisualEffectController" port="mIsRiperInContactInPort"/>
			</connection>
			<connection>
