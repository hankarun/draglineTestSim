			</connection>
			<connection>
				<from componentName="EngineController" port="mNoktaDonusOutPort"/>
				<to componentName="KinematicTrackActuator" port="mNoktaDonusInPort"/>
			</connection>
			<!-- Faz 1 palet swap: TrackActuator.mSuSeviyesiOutPort -> EngineController kaldirildi (KinematicTrackActuator su-seviyesi uretmez; SudaCalismaSeviyesi karada=0 default). -->
			<!-- Faz 1 palet swap: TrackActuator.mSuSeviyesiOutPort -> BulldozerJointActuator kaldirildi (kinematik palet su-seviyesi uretmez). -->
			<connection>
				<from componentName="BulldozerJointActuator" port="mIsBladeHitShakeStateOutPort"/>
				<to componentName="EngineController" port="mIsBladeHitShakeStateInPort"/>
			</connection>
			<connection>
				<from componentName="BulldozerJointActuator" port="mIsMudActiveOutPort"/>
				<to componentName="EngineController" port="mIsMudActiveInPort"/>
			</connection>
