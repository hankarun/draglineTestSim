				<to componentName="EngineController" port="mIsRiperInContactInPort"/>
			</connection>
			<connection>
				<from componentName="BulldozerJointActuator" port="mIsBladeInContactOutPort"/>
				<to componentName="EngineController" port="mIsBladeInContactInPort"/>
			</connection>
			<!-- Faz 1 palet swap: BulldozerJointActuator.mFrontWheelsCenterOffsetYOutPort -> TrackActuator kaldirildi (KinematicTrackActuator wheel-ground SR'dan okur). EngineController beslemesi (asagida) korunur. -->
			<!-- Faz 1 palet swap: BulldozerJointActuator.mBackWheelsCenterOffsetYOutPort -> TrackActuator kaldirildi (KinematicTrackActuator wheel-ground SR'dan okur). EngineController beslemesi (asagida) korunur. -->
			<connection>
				<from componentName="BulldozerJointActuator" port="mFrontWheelsCenterOffsetYOutPort"/>
				<to componentName="EngineController" port="mFrontWheelsCenterOffsetYInPort"/>
			</connection>
			<connection>
