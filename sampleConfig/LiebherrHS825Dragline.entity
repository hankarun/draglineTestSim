<?xml version="1.0" encoding="UTF-8"?>
<entity xmlns="http://www.simsoft.com.tr/EntityConfSchema" xmlns:attr="http://www.simsoft.com.tr/AttributeTypes" xmlns:sim="http://www.simsoft.com.tr/DataTypes" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<type-info>
		<super-type>0:1:1:-1:111:334:1:20</super-type>
		<!-- User controlled vehicles has the 'specific' byte set to 1 -->
		<!-- int superType, int kind, int domain, int country, int category, int subCategory, int specific, int extra -->
		<rpr-fom-type>0:1:1:-1:111:334:1:21</rpr-fom-type>
		<friendly-name>LiebherrHS825Dragline</friendly-name>
	</type-info>
	<entity-initials>
		<attribute-nvp name="mVehicleDefinitionXml" dynamicAttribute="true">
			<attribute xsi:type="attr:StringAttribute" value="./Data/Vehicles/LiebherrHS825/LiebherrHS825Phy.xml"/>
		</attribute-nvp>
		<!-- KinematicTankActuator.* SR konfigurasyonu ~GenericDragline base'inin
		     <initial-state-repository>'sinde (StateWrapper getSR()'tan okur; buradan
		     -entity-initials- okumaz). Makineye ozel deger override gerekirse base
		     yerine BURADAKI <local><initial-state-repository>'ye eklenir. -->
		<attribute-nvp dynamicAttribute="true" name="IconFile">
			<attribute xsi:type="attr:StringAttribute" value="./Contents/Vehicles/Land/LiebherrPR754Dozer/icon_2D.png"/>
		</attribute-nvp>
		<attribute-nvp name="SimIGConf" dynamicAttribute="true">
			<attribute xsi:type="attr:GenericAttribute" attributeClass="SimIGService.SimIGConfAttribute" xmlns:SimIG="http://www.simsoft.com.tr/SimIGConfAttributeSchema">
				<SimIG:mapping>
					<SimIG:entity type-id="12872" description="alt_govde" instance-id="1">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="mPose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="attachState" value="true"/>
						</SimIG:event>
						<!-- <SimIG:event type="SimIGService.SimIGWaterInteractionEvent"> -->
							<!-- <SimIG:combinedSourceAttribute> -->
								<!-- <SimIG:subAttribute name="Pose" value="mPose" /> -->
								<!-- <SimIG:subAttribute name="HPR" value="LiebherGovde.HPR"/> -->
								<!-- <SimIG:subAttribute name="Velocity" value="mVel"/> -->
								<!-- <SimIG:subAttribute name="OffsetVec" value="Liebherr.WaterFoamOffset"/> -->
								<!-- <SimIG:subAttribute name="BladeInWater" value="Liebherr.IsBladeInWater"/> -->
								<!-- <SimIG:subAttribute name="ReverseDirection" value="Liebherr.IsVehicleMovingBackward"/> -->
								<!-- <SimIG:subAttribute name="AngularSpeed" value="Liebherr.VehicleAngularSpeed"/> -->
								<!-- <SimIG:subAttribute name="UseAngularSpeed" value="Liebherr.IsMigferDonmesiActive"/> -->
								<!-- <SimIG:subAttribute name="Active" value="Liebherr.FoamInWaterActive"/> -->
							<!-- </SimIG:combinedSourceAttribute> -->
							<!-- <SimIG:mapping name="Width" value="2.5"/> -->
							<!-- <SimIG:mapping name="Length" value="5"/> -->
							<!-- <SimIG:mapping name="Radius" value="1"/> -->
							<!-- <SimIG:mapping name="FoamColor" value="0.94 0.68 0.54"/> -->
						<!-- </SimIG:event> -->
						<SimIG:event type="SimIGService.SimIGShortComponentControlEvent" sourceAttribute="Misc.LeftSignal">
							<SimIG:mapping name="CompID" value="1"/>
							<SimIG:mapping name="CompClassID" value="0"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGShortComponentControlEvent" sourceAttribute="Misc.RightSignal">
							<SimIG:mapping name="CompID" value="2"/>
							<SimIG:mapping name="CompClassID" value="0"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGMirrorControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="RotationOffsetAttr" value="Misc.RightMirrorOffsetAngle"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CameraID" value="6"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGMirrorControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="RotationOffsetAttr" value="Misc.LeftMirrorOffsetAngle"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CameraID" value="5"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGComponentControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Active" 	value="VisualEffect.TrackFrontLeftDustActive"/>
								<SimIG:subAttribute name="Radius" 	value="VisualEffect.TrackDustRadius"/>
								<SimIG:subAttribute name="Lifetime" value="VisualEffect.TrackDustDuration" />
							<SimIG:subAttribute name="Pose" 	value="VisualEffect.TrackFrontLeftDustPose" />
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CompID" value="3"/>
							<SimIG:mapping name="InstanceID" value="-1"/>
							<SimIG:mapping name="ParticleID" value="1"/>
							<SimIG:mapping name="RadiusMultiplier" value="1.0"/>
							<SimIG:mapping name="LifetimeMultiplier" value="1.0"/>
							<SimIG:mapping name="IsOneShot" value="false"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGComponentControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Active" 	value="VisualEffect.TrackFrontRightDustActive"/>
								<SimIG:subAttribute name="Radius" 	value="VisualEffect.TrackDustRadius"/>
								<SimIG:subAttribute name="Lifetime" value="VisualEffect.TrackDustDuration" />
								<SimIG:subAttribute name="Pose" 	value="VisualEffect.TrackFrontRightDustPose" />
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CompID" value="3"/>
							<SimIG:mapping name="InstanceID" value="-1"/>
							<SimIG:mapping name="ParticleID" value="2"/>
							<SimIG:mapping name="RadiusMultiplier" value="1.0"/>
							<SimIG:mapping name="LifetimeMultiplier" value="1.0"/>
							<SimIG:mapping name="IsOneShot" value="false"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGComponentControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Active" 	value="VisualEffect.TrackBackLeftDustActive"/>
								<SimIG:subAttribute name="Radius" 	value="VisualEffect.TrackDustRadius"/>
								<SimIG:subAttribute name="Lifetime" value="VisualEffect.TrackDustDuration" />
								<SimIG:subAttribute name="Pose" 	  value="VisualEffect.TrackBackLeftDustPose" />
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CompID" value="3"/>
							<SimIG:mapping name="InstanceID" value="-1"/>
							<SimIG:mapping name="ParticleID" value="3"/>
							<SimIG:mapping name="RadiusMultiplier" value="1.0"/>
							<SimIG:mapping name="LifetimeMultiplier" value="1.0"/>
							<SimIG:mapping name="IsOneShot" value="false"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGComponentControlEvent">
							<SimIG:combinedSourceAttribute>
							<SimIG:subAttribute name="Active" 	value="VisualEffect.TrackBackRightDustActive"/>
							<SimIG:subAttribute name="Radius" 	value="VisualEffect.TrackDustRadius"/>
							<SimIG:subAttribute name="Lifetime" value="VisualEffect.TrackDustDuration" />
							<SimIG:subAttribute name="Pose" 	  value="VisualEffect.TrackBackRightDustPose" />
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CompID" value="3"/>
							<SimIG:mapping name="InstanceID" value="-1"/>
							<SimIG:mapping name="ParticleID" value="4"/>
							<SimIG:mapping name="RadiusMultiplier" value="1.0"/>
							<SimIG:mapping name="LifetimeMultiplier" value="1.0"/>
							<SimIG:mapping name="IsOneShot" value="false"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGComponentControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Active" value="VisualEffect.ExhaustSmokeEnable"/>
								<SimIG:subAttribute name="Pose" value="VisualEffect.ExhaustSmokePose" />
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="CompID" value="11"/>
							<SimIG:mapping name="InstanceID" value="1"/>
							<SimIG:mapping name="ParticleID" value="1"/>
							<SimIG:mapping name="Radius" value="0.2"/>
							<SimIG:mapping name="Lifetime" value="0.5"/>
							<SimIG:mapping name="IsOneShot" value="false"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="12870" description="MainBody" instance-id="2">
						<SimIG:selectableViews>
							<SimIG:view viewName="Dozer Simulator Inside Front View" />
							<SimIG:view viewName="Dozer Simulator Inside Right View" />
							<SimIG:view viewName="Dozer Simulator Inside Left View" />
							<SimIG:view viewName="Dozer Simulator Inside Back View" />
							<SimIG:view viewName="Dozer Simulator Up Right Front View" />
							<SimIG:view viewName="Dozer Simulator Up Left Front View" />
							<SimIG:view viewName="Dozer Simulator Up Right Back View" />
							<SimIG:view viewName="Dozer Simulator Up Left Back View" />
						</SimIG:selectableViews>
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="BdSR[1]->Bd.Pose" />
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<!-- IsStill="true" mapping GECICI OLARAK KALDIRILDI (deney): eski entity'de
							     MainBody hareketsiz idi (slew BoomBody'nin PosPYR'i uzerinden yapilirdi).
							     Yeni mimaride MainBody DraglineActuator slew yaw'ini absolute pose ile
							     uygular -> IG her tick update almali. IsStill=true belki IG'ye polling
							     yapmamasi sinyali veriyordu. Test sonucuna gore kalici karar verilir. -->
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGShortComponentControlEvent" sourceAttribute="Bulldozer.FrontProjectorLights">
							<SimIG:mapping name="CompID" value="16"/>
							<SimIG:mapping name="CompClassID" value="0"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13227" description="mirror-left" instance-refid="2">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Misc.LeftMirrorOffset"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="attachState" value="false"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="12873" description="BoomBody" instance-id="6">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="BdSR[2]->Bd.Pose"/>
								<!-- Faz 1: BoomBody, MainBody gibi BdSR[2]->Bd.Pose absolute pose'a baglandi (DraglineActuator boom luffing'i KinematicPart ile surer); eski child(instance-refid=2)+PosPYR/PositionOffset kaldirildi. -->
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13272" description="Boom Alt Makara" instance-refid="6">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Boom.TopMakara"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13273" description="Boom Ust Makara" instance-refid="6">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Boom.BottomMakara"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13241" description="silecek_onSilecek" instance-refid="2">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Wiper.FrontWiperPositionOffset"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGModelAnimationControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="AnimationSpeedAttr" value="Wiper.FrontWiperAnimationSpeed"/>
								<SimIG:subAttribute name="AnimationStatusAttr" value="Wiper.FrontWiperAnimationStatus"/>
								<SimIG:subAttribute name="AnimationLoopModeAttr" value="Wiper.FrontWiperAnimationLoopMode"/>
								<SimIG:subAttribute name="AnimationCurrentTimeAttr" value="Wiper.FrontWiperAnimationCurrentTime"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="AnimationIndex" value="0"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13207" description="su-puskurtme-on" instance-refid="2">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Wiper.FrontWiperWaterOffset"/>
								<SimIG:subAttribute name="Visibility" value="Wiper.FrontWiperWaterEffect"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
					</SimIG:entity>
					<!-- ★ K4 (2026-08-12): kol_alt_makara (drag halati fairlead makarasi) gorseli.
					     BoomBody ile AYNI poz'a (BdSR[2]->Bd.Pose) baglandi -> boma bagli (kullanici
					     secimi); prefab'in kendi ofseti (koordinatlar.txt -0.03162/1.55029/1.38704,
					     govde_kol ile ayni cerceve) makarayi boom ayaginda konumlandirir. Drag halati
					     (RopeHandlerFromMainFrontToBucketEnd) bu makaradan cikip kepce_on'a gider. -->
					<SimIG:entity type-id="12874" description="kol_alt_makara" instance-id="7">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="BdSR[2]->Bd.Pose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<!-- ★ 2026-08-31 statik_halat (boom standing pendant): iki ucu da boom
					     assembly'sinde -> boom luff ederken RIJIT doner, boyu DEGISMEZ.
					     Desen = kol_alt_makara: sadece boom pozuna (BdSR[2]->Bd.Pose) baglanir;
					     prefab kendi ofsetiyle (koordinatlar.txt 0.117821/1.551746/1.385935)
					     boom ayagina oturur. C++ YOK. SimIGTypeList type 13290. -->
					<SimIG:entity type-id="13259" description="statik_halat" instance-id="8">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="BdSR[2]->Bd.Pose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<!-- halat (boom-hoist halati): DraglineActuator her tick makara_alt_arka ile
					     makara_ust_arka arasina pose + scale yazar (updateBoomHoistRopeVisual).
					     ★ Instance MainBody COCUGU (refid 2) -> Pose MAIN-YEREL'dir, dunya DEGIL.
					     POZ hep alt makarada (SABIT); bom luff ettikce sadece DONUS ve yerel
					     Z-SCALE degisir -> iki makara arasi mesafe daima korunur. Mesh'in pivotu
					     alt uctadir ve yerel +Z boyunca 6.0833 m uzanir; SimIGScaleObjectEvent
					     yerel eksende olcekledigi icin ucu tam ust makaraya oturur. -->
					<SimIG:entity type-id="13260" description="halat" instance-refid="2">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="Dragline.BoomHoistRopePose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
						<SimIG:event type="SimIGService.SimIGScaleObjectEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="ScaleAmountsAttr" value="Dragline.BoomHoistRopeScale"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
					</SimIG:entity>
					<!-- ★ K4c (2026-08-17): FAIRLEAD DIKEY KILAVUZ MAKARALARI (makara_dik_sag / makara_dik_sol)
					     drag halati cekilirken/salinirken DONER. Iki mesh kol_alt_makara.simig'den AYRILDI
					     (orada artik YOK; kendi prefab'lari makara_dik_{sag,sol}.simig, SimIGTypeList type
					     12889/12895) ve burada kol_alt_makara instance'inin (instance-refid="7") COCUGU
					     olarak bagimsiz poz+donus ile surulur -> gerisi (kol_alt_makara/makara_alt/
					     makara_baslik/makara_ust) eskisi gibi bomla birlikte SABIT kalir.
					     Desen = PhyMercedes3343 "projector-lambasi" (cocuk prefab + PosPYR ile canli donus).
					       POZ  : ASAGIDAKI PosPYR attribute'unun kendi <attr:pos> degeri (bom-yerel;
					              modelcinin mesh konumu = sag +0.0988 / sol -0.1026, y 0.5715, z 3.1733).
					              DraglineActuator POZA DOKUNMAZ, yalniz YAW yazar -> buradan serbestce
					              ince ayar yapilabilir (dynamicAttribute: egitmen UI'sindan da).
					       DONUS: yaw = drag halat hizindan integre edilen aci (DraglineActuator, her tick).
					              sag/sol TERS isaretlidir -> iki makaranin halata bakan yuzu AYNI yonde
					              yuvarlanir: halat CEKILIRKEN ice, SALINIRKEN disa.
					       pitch: modelcinin orijinal 4.989 derece egimi BILEREK 0 yapildi (yaw ekseni
					              makaranin KENDI ekseni olsun); egim yaw ile birlikte presesyon yapardi (=
					              donerken egilme yonu de donerdi, 4 cm'lik gorunur salinim). -->
					<SimIG:entity type-id="12889" description="makara_dik_sag" instance-refid="7">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Rig.FairleadRollerSagPosPyr"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="12895" description="makara_dik_sol" instance-refid="7">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Rig.FairleadRollerSolPosPyr"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13251" description="makara_alt" instance-refid="7">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Rig.FairleadRollerAltPosPyr"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13250" description="makara_ust" instance-refid="7">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Rig.FairleadRollerUstPosPyr"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<!-- ARKA GANTRY MAKARALARI (makara_ust_arka / makara_alt_arka).
					     Alt makara MainBody'de kalir; ust makara BoomBody cocugu oldugu icin boom luff eder.
					     DraglineActuator halat.simig pose/scale degerini bu iki nokta arasina yazar. -->
					<SimIG:entity type-id="13261" description="makara_ust_arka" instance-refid="6">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Rig.RearSheaveUstPosPyr"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13262" description="makara_alt_arka" instance-refid="2">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Rig.RearSheaveAltPosPyr"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13252" description="Indicator Plate" instance-refid="6">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Indicator_Plate"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<SimIG:mapping name="IsStill" value="true"/>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="13253" description="Indicator Dial" instance-refid="6">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="PosPYR" value="Dragline.Indicator_Dial"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="12983" description="BucketBody" instance-id="3">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="BucketBodyPose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
							</SimIG:combinedSourceAttribute>
							<!-- IsStill kaldirildi (Step 3): kova(Body/Top/Bottom) artik KinematicPart::apply / SR ile her tick poz alir; IsStill=true IG'yi statik tutup runtime poz guncellemesini gizleyebilir (MainBody/BoomBody'de de kaldirildi). -->
						</SimIG:event>
					</SimIG:entity>
					<SimIG:entity type-id="12985" description="BucketBottomBody" instance-id="4">
						<SimIG:event type="SimIGService.SimIGEntityControlEvent">
							<SimIG:combinedSourceAttribute>
								<SimIG:subAttribute name="Pose" value="BucketBottomBodyPose"/>
								<SimIG:subAttribute name="Visibility" value="mEnabled"/>
