			</attribute-nvp>
			<!-- Sogutma suyu seviyesi ON UYARI (sari) - ekranda birsey yakmaz -->
			<attribute-nvp name="Bulldozer.WaterCoolantLevelPreWarningMalfunction">
				<attribute xsi:type="attr:BoolAttribute" value="false"/>
