	<local>
		<initial-state-repository classType="SimFramework.SimObj.SimObjectStateRepository">
<!-- ================================================================
		     Faz 1 palet kinematik swap: TrackActuator.* -> KinematicTrackActuator.*
		     (dozer LiebherrPR756 kalibi). KinematicTrackStateWrapper getSR()'tan
		     okur. Geometri (pulley/carrier Z/Y, Radious) HS825 ILK TAHMIN'dir
		     (wheel layout: WheelStartZ=2.2/EndZ=-2.2, WheelLocalY=0.30,
		     HalfWidth=1.4) -> in-sim ayarlanacak. Shoe mesh = 12871 (HS825),
		     58 shoe. SpeedMultiplayer=Resolution=600 (no-slip; KinematicTank
		     fiziksel m/s besler). WheelGround prefix'leri KinematicTankActuator'in
		     yayinladigi SR isimleriyle eslesir. dynamicAttribute'lar egitmen
		     UI/SR'dan canli ince-ayar.
		================================================================ -->
		<attribute-nvp name="KinematicTrackActuator.TrackShoeCount">
			<attribute xsi:type="attr:IntAttribute" value="51"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.VisualModelTypeId">
			<attribute xsi:type="attr:IntAttribute" value="12871"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.WheelGroundLeftPrefix">
			<attribute xsi:type="attr:StringAttribute" value="KinematicTankActuator.WheelGroundLeft"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.WheelGroundRightPrefix">
			<attribute xsi:type="attr:StringAttribute" value="KinematicTankActuator.WheelGroundRight"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.Radious" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.5"/>
		</attribute-nvp>
		<!-- Ayri travel palet pedali modu (work-mode'un yerini aldi). Bu bayrak base
		     ~GenericDragline'da da var; ama concrete entity'de de tanimlanir ki tank'in
		     dogrudan getAttributePtr okumasi base/concrete merge'inden bagimsiz GARANTI
		     resolve etsin. true -> KinematicTankActuator independent-pedal modu acik. -->
		<attribute-nvp name="KinematicTankActuator.IndependentPedalDriveEnabled" dynamicAttribute="true">
			<attribute xsi:type="attr:BoolAttribute" value="true"/>
		</attribute-nvp>
		<!-- HS825 yol-tekerleği yerleşimi (A2..A10 = 9 teker). Base ~GenericDragline'daki
		     generic değerleri (4 teker, 2.2/-2.2, 1.4) override eder; concrete'te tanımlı
		     olması tank'in getAttributePtr okumasını GARANTİ resolve eder (bkz.
		     IndependentPedalDriveEnabled notu). Yandan (yarı-genişlik) ±1.38598. -->
		<attribute-nvp name="KinematicTankActuator.WheelCountPerTrack" dynamicAttribute="true">
			<attribute xsi:type="attr:IntAttribute" value="9"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTankActuator.WheelStartZ" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="1.54001"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTankActuator.WheelEndZ" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="-1.55289"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTankActuator.WheelTrackHalfWidth" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="1.38598"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.RadiousOffset" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.CenterOffset" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.4"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.HorizontalOffset" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.LateralShift" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
		</attribute-nvp>
		<!-- HS825 ÖLÇÜLEN gerçek belt geometrisi (A1=sprocket arka, A13=idler ön,
		     A11/A12=carrier). Front=+Z (idler A13), Rear=-Z (sprocket A1).
		     Arka(sprocket) yarıçap 0.408, ön(idler) yarıçap 0.342. -->
		<attribute-nvp name="KinematicTrackActuator.FrontPulleyZ" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="2.14892"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.FrontPulleyY" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.464003"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.RearPulleyZ" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="-2.13955"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.RearPulleyY" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.476899"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.FrontPulleyRadius" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.342"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.RearPulleyRadius" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.408"/>
		</attribute-nvp>
		<!-- Carrier (ust destek) makaralari A11/A12: üst şerit yüksekliği ~0.863. -->
		<attribute-nvp name="KinematicTrackActuator.Carrier0Z" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="-0.523467"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.Carrier0Y" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.86342"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.Carrier1Z" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.522187"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.Carrier1Y" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.86342"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.CarrierRadius" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.1"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TopRunY" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.86342"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.Resolution">
			<attribute xsi:type="attr:IntAttribute" value="600"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.SpeedMultiplayer">
			<attribute xsi:type="attr:FloatAttribute" value="600"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.ResonanceMultiplayer">
			<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.SagShapeExponent" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="2.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.MaxSagMeters" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.08"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.MaxFrictionPenalty" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.15"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TensionLevel" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.5"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.PalletStateLooseTension" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.1"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.PalletStateNormalTension" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.4"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.PalletStateTightTension" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.9"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.JitterSpeedRef" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="1.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.LowTensionJitterAmplitude" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.02"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.LowTensionJitterThreshold" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.20"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TrackSignCountPerWheel">
			<attribute xsi:type="attr:IntAttribute" value="6"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TrackSignHorizontalOffset">
			<attribute xsi:type="attr:FloatAttribute" value="0.40"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TrackSignMaxCompression">
			<attribute xsi:type="attr:FloatAttribute" value="1.0003"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TrackSignMaxHardness">
			<attribute xsi:type="attr:FloatAttribute" value="120.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TrackSignPositionOffsets">
			<attribute xsi:type="attr:Vec3Attribute">
				<attr:vec3 x="0.15" y="0.0" z="0.0"/>
			</attribute>
		</attribute-nvp>
		<!-- Per-shoe detay trace log. Bkz. KinematicTrackStateWrapper
			 ShoeDetailLoggerEnabled yorumu. Default false. -->
		<attribute-nvp name="KinematicTrackActuator.ShoeDetailLoggerEnabled" dynamicAttribute="true">
			<attribute xsi:type="attr:BoolAttribute" value="false"/>
		</attribute-nvp>
		<!-- Bakla zemin payı (grouser clearance, m) - RUNTIME. Alt zinciri
			 +Y kaldırır ki tırtık (grouser) ucu zemine değsin, gövde üstte
			 kalsın (palet yere batmasın). ~0.06 alt şeridi idler tabanı
			 hizasına çeker (ön kink de azalır); daha derin batma varsa artır
			 ve gerekiyorsa Front/RearPulleyY'yi de yükselt. 0 = kaldırma yok. -->
		<attribute-nvp name="KinematicTrackActuator.ShoeGroundClearance" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.22"/>
		</attribute-nvp>
		<!-- Gerçek bakla mesh adımı (pitch, m) - RUNTIME. >0 verilince render
			 edilen bakla sayısı = round(hull çevresi / pitch) olur ve baklalar
			 UÇ UCA dizilir (üst üste binme / dönüşte kopukluk biter); fazlası
			 gizlenir (Enable=false). 0 = devre dışı (TrackShoeCount kadar, eski
			 davranış). 0'dan başlayıp baklalar tam oturana kadar artır. -->
		<attribute-nvp name="KinematicTrackActuator.ShoeMeshPitch" dynamicAttribute="true">
			<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
		</attribute-nvp>
		<attribute-nvp name="KinematicTrackActuator.TraceDataLoggerEnabled" dynamicAttribute="true">
			<attribute xsi:type="attr:BoolAttribute" value="false"/>
		</attribute-nvp>
			<attribute-nvp name="BucketBodyPose">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="BucketBottomBodyPose">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="BucketTopBodyPose">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<!-- ★ 2026-09-02 spreader bar (SimIG 13268) DUNYA pozu; DraglineActuator yazar. -->
			<attribute-nvp name="SpreaderBarPose">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="BucketBackPart">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="BucketFrontRightPart">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="-0.898424" y="0.078460" z="-2.042474"/> 
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="BucketFrontLeftPart">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0.898424" y="0.078461" z="-2.042474"/> 
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="RearRollerPolePose">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<!-- DraglineBladeBodyPose: KINEMATIK DraglineBlade govdesinin poz
			     attribute'u (KinematicPart::resolve poseAttr ZORUNLU). SimIG
			     binding YOK (blade gorselsiz collision-only). init-time identity
			     placeholder; DraglineActuator her tick solver poziyla yazar. -->
			<attribute-nvp name="DraglineBladeBodyPose">
                <attribute xsi:type="attr:Mat44Attribute">
                    <attr:pose>
                        <sim:rotation x="0" y="0" z="0"/>
                        <sim:position x="0" y="0" z="0"/>
                    </attr:pose>
                </attribute>
            </attribute-nvp>
			<attribute-nvp name="RopePayOut">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<attribute-nvp name="RopeHorizontalInput">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<attribute-nvp name="RopeVerticalInput">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<!-- DragPullForce: scaled-Newton accumulator published by
			     LiebherrHS825Actuator each tick via GetStateWrapper()->
			     setDragPullForce(...). Without this declaration the
			     StateWrapper's setter logs SIM_LOG_ERROR and silently no-ops
			     (1-arg getAttributePtr_nonConst doesn't auto-create), which
			     would leave PhyDeformableTerrainEntity reading the default
			     0.0f every tick — and therefore digDepth = 0 forever.
			     Defaults to 0; not dynamicAttribute because it's runtime
			     state, not an instructor knob. -->
			<attribute-nvp name="DragPullForce">
				<attribute xsi:type="attr:FloatAttribute" value="0.0"/>
			</attribute-nvp>
			<!-- Dragline.Dig.AdvGateK: ilerleme-kapili isirma carpani (0..1), DraglineActuator
			     her tick yazar; PhyDeformableTerrainEntity okuyup dragline hucre-drop tavanini
			     bununla carpar (duran dis terrain kanalindan da kesemez; 2026-08-29b,
			     trace 221015 yerinde-kazi konveyoru dersi). DragPullForce ile ayni kalip:
			     deklarasyon olmadan aktuatorun 2-arg getAttributePtr_nonConst'u nullptr doner
			     ve yayin sessizce olmaz (terrain 1.0 varsayar = eski davranis). Runtime state;
			     dynamicAttribute degil. -->
			<attribute-nvp name="Dragline.Dig.AdvGateK">
				<attribute xsi:type="attr:FloatAttribute" value="1.0"/>
			</attribute-nvp>
			<!-- Dragline.Dig.CutFloorY: kesim tabani yayini (2026-08-29d). DraglineActuator
			     kazi tick'lerinde solver datum'unu (bite+tavan+filtre sonrasi on taban,
			     dunya-Y m) yazar; kazi disinda sentinel (-1e9 alti). Terrain hucre hedefini
			     bununla alttan kelepceler = arazi datum'un altina kazilamaz (kinematik
			     moddaki temiz/duz kazi semantigi). AdvGateK ile ayni kalip: deklarasyon
			     yoksa yayin sessizce olmaz, terrain sentinel varsayar (kelepce yok).
			     Runtime state; dynamicAttribute degil. -->
			<attribute-nvp name="Dragline.Dig.CutFloorY">
				<attribute xsi:type="attr:FloatAttribute" value="-1000000000.0"/>
			</attribute-nvp>
			<!-- ★ 2026-08-25 HOIST HALAT GORSELI 4 -> 12 SEGMENT.
			     C++ (DraglineActuator mHoistRope) 13 dugum = 12 segment yaziyor; bu liste
