			<!-- COLLIDABLE (eski kova fizik yapisi): 7 convex part terrain ile temas uretir ->
			     DraglineActuator kovayi KENDI govde temaslariyla yere oturtur (egimli zeminde
			     on/arka ayri yukseklige). Kinematik kalir (joint yok; actuator apply surer).
			     canDeform KODDA acilmaz -> kabuk arazi DEFORME ETMEZ, yalniz temas verir
			     (deformu yalniz DraglineBlade yapar). SELF_CONDUCTIVE = blade ile ayni;
			     karsilikli blade<->kabuk temaslari listener'da dt_ filtresiyle elenir. -->
			<collisionFilter word0="COLLISION_FLAG_SELF_CONDUCTIVE" word1="COLLISION_FLAG_SELF_CONDUCTIVE_AGAINST"/>
